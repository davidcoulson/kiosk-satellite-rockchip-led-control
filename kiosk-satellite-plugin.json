{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "rockchip-led-control",
  "name": "Rockchip LED Control",
  "version": "0.2.5-20260915",
  "minAndroidSdk": 24,
  "entryClass": "me.jxl.kiosk.plugins.rockchip.RockchipLedPlugin",
  "description": "Control the RGB status LED on compatible panels with a /dev/ledjni driver. Set its color, brightness and effect here or through Home Assistant.",
  "author": "David Coulson",
  "license": "Apache-2.0",
  "capabilities": [
    "native",
    "entities"
  ],
  "settings": [
    {
      "key": "power",
      "type": "boolean",
      "title": "LED on",
      "default": false,
      "group": "LED"
    },
    {
      "key": "color",
      "type": "color",
      "title": "Color",
      "default": "#00A8FF",
      "group": "LED"
    },
    {
      "key": "brightness",
      "type": "number",
      "title": "Brightness",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "group": "LED"
    },
    {
      "key": "effect",
      "type": "select",
      "title": "Effect",
      "options": [
        "None",
        "Pulse",
        "Blink",
        "Rainbow",
        "Candle",
        "Random",
        "Sunrise/Sunset",
        "Moonlight Glow",
        "Lightning Storm",
        "Wake-Up Alarm",
        "Candle Flicker",
        "Fairytwinkle",
        "Fireworks Burst",
        "Beacon Pulse",
        "Heartbeat Pulse",
        "Soft Glow",
        "Rolling Fog (Pronounced)",
        "Pacifica (Calm Lagoon)",
        "Pacifica (Storm)",
        "Pacifica (Deep Current)",
        "Aurora (Solar Storm)",
        "Aurora (Pastel Dream)",
        "Aurora (Red Sky)",
        "Bubbles",
        "Disco Sparkle"
      ],
      "default": "None",
      "group": "LED"
    },
    {
      "key": "period",
      "type": "number",
      "title": "Effect period",
      "min": 500,
      "max": 10000,
      "step": 100,
      "default": 2000,
      "unit": "ms",
      "group": "LED"
    },
    {
      "key": "exposeLight",
      "type": "boolean",
      "title": "Expose to Home Assistant",
      "description": "Adds an RGB light to the kiosk ESPHome device when the LED is available.",
      "default": true,
      "group": "Home Assistant"
    },
    {
      "key": "maxDrive",
      "type": "number",
      "title": "Maximum channel drive",
      "description": "Starts at 15 to match the conservative range reported by the original hardware research. Calibrate higher values on your panel.",
      "min": 1,
      "max": 255,
      "step": 1,
      "default": 15,
      "group": "Hardware"
    },
    {
      "key": "allowRoot",
      "type": "boolean",
      "title": "Allow root fallback",
      "description": "Use a plugin helper through su only if direct LED access is denied. Your root manager may ask you to grant access.",
      "default": false,
      "group": "Hardware"
    },
    {
      "key": "simulation",
      "type": "boolean",
      "title": "Simulation mode",
      "description": "Test the controls without touching hardware. Home Assistant labels the light as simulated.",
      "default": false,
      "group": "Developer Tools"
    }
  ],
  "commands": [
    {
      "id": "detect",
      "title": "Check hardware access"
    },
    {
      "id": "test",
      "title": "Test red, green and blue"
    },
    {
      "id": "off",
      "title": "Turn LED off"
    }
  ]
}
